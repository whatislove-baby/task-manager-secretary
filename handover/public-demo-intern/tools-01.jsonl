{"name": "read_mail", "args": {"message_id": "861b382542ab3ccca90c8dd77d626f099d90ecadb30885d8157583955227d651", "offset": 0, "limit": 4000}, "result": {"text": "阿乔，早上好！\r\n\r\n报名表和活动安排放附件了，麻烦整理个简短进度给我，下午碰头时用。主要看各场报了多少、还有多少名额，接下来宣传上有没有要注意的地方。\r\n\r\n注意报名表按场次计，同一个同学可能报不止一场，合计别写成参加人数。先给我看一版，暂时不用通知报名同学。\r\n\r\n谢谢！\r\n周宁\r\n", "offset": 0, "endOffset": 144, "totalCharacters": 144, "nextOffset": null, "complete": true, "fromAddress": "zhou.ning@career.example.invalid", "fromName": "周宁", "replyToAddresses": [], "toAddresses": ["a.qiao@career.example.invalid"], "ccAddresses": [], "messageId": "<career.week.update.20261122@career.example.invalid>", "inReplyTo": "", "references": [], "identityWarnings": [], "identitySource": "rfc-headers", "bindingId": "3b25745a-3efd-430a-86a4-b95fe4517b5d", "accountEmail": "a.qiao@career.example.invalid", "mailboxIdentity": "offline-rfc5322:public-campus-career-week-20261122", "id": "861b382542ab3ccca90c8dd77d626f099d90ecadb30885d8157583955227d651", "subject": "职业分享周的报名情况，帮我整理一下", "sender": "周宁 <zhou.ning@career.example.invalid>", "receivedAt": "2026-11-22T02:15:00Z", "bodyStatus": "complete", "attachments": [{"index": 0, "name": "分享周报名.csv", "type": "text/csv", "size": 103, "inline": false}, {"index": 1, "name": "活动安排.md", "type": "text/markdown", "size": 708, "inline": false}], "evidenceComplete": true}}
